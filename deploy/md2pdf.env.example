MD2PDF_HOSTED=1
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
MD2PDF_SECRET_KEY=replace-with-a-random-secret
MD2PDF_WORKSPACE_ROOT=/var/lib/md2pdf/workspaces
# Optional: stored-Markdown growth per network per hour (default 100 MB).
# MD2PDF_HOURLY_BYTES=104857600
PLAYWRIGHT_BROWSERS_PATH=/opt/md2pdf/browsers
NBOW_SHARE_BASE=https://nbow.io
# Editing assistant: the server's own Ollama, reached on loopback. No API key
# and no third-party provider. The defaults are what production runs.
# MD2PDF_OLLAMA_URL=http://127.0.0.1:11434
# Default qwen3:1.7b (Apache 2.0); pull it first: `ollama pull qwen3:1.7b`.
# Do NOT use qwen2.5:3b here: its Qwen RESEARCH LICENSE forbids commercial use.
# MD2PDF_LLM_MODEL=qwen3:1.7b
# Longest document the assistant reads, in characters (default 4000; sized for
# a small model on 2 vCPUs to answer within the 180 s budget).
# MD2PDF_LLM_MAX_DOCUMENT_CHARS=4000
# Seconds of assistant generation per network per hour (default 600).
# MD2PDF_LLM_HOURLY_SECONDS=600
